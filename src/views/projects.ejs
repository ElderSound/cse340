
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Explore our upcoming service projects and the organizations sponsoring them.</p>

    <ul class="project-list">
        <% projects.forEach(project => { %>
            <li>
                <strong>
                    <%= new Date(project.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        timeZone: 'UTC'
                    }) %>:
                    <%= project.title %>
                </strong>

                (<em><%= project.organization_name %></em>)

                <p><%= project.description %></p>
                <p>Location: <%= project.location %></p>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
