
<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>
        Explore our next five upcoming service projects
        and the partner organizations behind them.
    </p>

    <ul class="project-list">
        <% projects.forEach(project => { %>
            <li>
                <h2>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>
                </h2>

                <p>
                    <strong>Partner Organization:</strong>
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                </p>

                <p><%= project.description %></p>

                <p>
                    <strong>Date:</strong>
                    <%= new Date(project.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        timeZone: 'UTC'
                    }) %>
                </p>

                <p>
                    <strong>Location:</strong>
                    <%= project.location %>
                </p>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
