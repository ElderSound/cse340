
<%- include('partials/header') %>

<main>
    <h1><%= category.name %></h1>

    <p>
        Explore the service projects associated
        with this category.
    </p>

    <h2>Service Projects</h2>

    <% if (projects.length > 0) { %>
        <ul class="project-list">
            <% projects.forEach(project => { %>
                <li>
                    <h3>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h3>

                    <p><%= project.description %></p>

                    <p>
                        <strong>Organization:</strong>
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No service projects are currently available in this category.</p>
    <% } %>

    <p>
        <a href="/categories">Back to Service Categories</a>
    </p>
</main>

<%- include('partials/footer') %>
