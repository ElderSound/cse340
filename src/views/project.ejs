
<%- include('partials/header') %>

<main>
    <h1><%= project.title %></h1>

    <h2>Project Details</h2>

    <p>
        <strong>Description:</strong>
        <%= project.description %>
    </p>

    <p>
        <strong>Date:</strong>
        <%= new Date(project.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC'
        }) %>
    </p>

    <p>
        <strong>Location:</strong>
        <%= project.location %>
    </p>

    <p>
        <strong>Partner Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <p>
        <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
    </p>

    <h2>Project Categories</h2>

    <% if (categories.length > 0) { %>
        <ul class="category-tags">
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories assigned to this project.</p>
    <% } %>

    <p>
        <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
    </p>

    <p>
        <a href="/projects">Back to Upcoming Service Projects</a>
    </p>
</main>

<%- include('partials/footer') %>
